# Copia este archivo como .env y llena los valores de tu proyecto Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Correo de contacto que aparece en la política de tratamiento de datos
VITE_CONTACTO_EMAIL=tucorreo@ejemplo.com
